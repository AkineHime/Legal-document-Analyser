<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.statigate</groupId>
        <artifactId>statigate-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>desktop</artifactId>
    <name>statigate-desktop</name>
    <description>
        JavaFX desktop front end. Programmatic UI (no FXML), zero network calls, talks to the same
        offline AnalysisPipeline as the CLI. Depends only on the library modules, never the reverse.
    </description>

    <properties>
        <main.class>io.statigate.desktop.StatigateApp</main.class>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.statigate</groupId>
            <artifactId>core</artifactId>
        </dependency>
        <dependency>
            <groupId>io.statigate</groupId>
            <artifactId>nlp</artifactId>
        </dependency>
        <dependency>
            <groupId>io.statigate</groupId>
            <artifactId>extraction</artifactId>
        </dependency>
        <dependency>
            <groupId>io.statigate</groupId>
            <artifactId>grounding</artifactId>
        </dependency>
        <dependency>
            <groupId>io.statigate</groupId>
            <artifactId>pipeline</artifactId>
        </dependency>

        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
            <classifier>${javafx.platform}</classifier>
        </dependency>

        <!-- Local document library: PipelineResult and its component records are plain Java
             records, which jackson-databind has serialized natively (no extra module) since 2.12. -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <scope>runtime</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>statigate-desktop</finalName>
        <plugins>
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <configuration>
                    <mainClass>${main.class}</mainClass>
                    <launcher>statigate-desktop</launcher>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
